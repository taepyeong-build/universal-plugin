{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/hooks-spec.schema.json",
  "title": "Canonical Hooks Specification",
  "type": "object",
  "required": ["groups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rules"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "enabled": { "type": "boolean" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["event", "policy"],
              "additionalProperties": false,
              "properties": {
                "event": {
                  "type": "string",
                  "enum": ["session.start", "prompt.submit", "tool.before", "tool.after", "turn.stop"]
                },
                "actions": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["shell.exec", "fs.write", "fs.read", "all"] }
                },
                "policy": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 120 },
                "runtimes": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["antigravity", "claude", "codex"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
