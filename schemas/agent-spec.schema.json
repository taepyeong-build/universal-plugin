{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-spec.schema.json",
  "title": "Canonical Subagent Specification",
  "type": "object",
  "required": ["name", "description", "capabilities", "instructions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "description": { "type": "string", "minLength": 10 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["read", "search", "write", "exec"] }
    },
    "modelTier": { "type": "string", "enum": ["inherit", "fast", "reasoning"] },
    "instructions": { "type": "string", "minLength": 20 }
  }
}
