{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/registry.schema.json",
  "title": "Universal Plugin Marketplace Registry",
  "type": "object",
  "required": ["marketplace", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "marketplace": {
      "type": "object",
      "required": ["name", "displayName", "description", "version", "owner", "repository"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "owner": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "repository": {
          "type": "object",
          "required": ["slug", "url", "branch"],
          "additionalProperties": false,
          "properties": {
            "slug": { "type": "string", "minLength": 3 },
            "url": { "type": "string", "format": "uri" },
            "branch": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "category", "policy"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "path": { "type": "string", "pattern": "^plugins/[a-z0-9][a-z0-9-]{0,63}$" },
          "category": { "type": "string", "minLength": 1 },
          "policy": {
            "type": "object",
            "required": ["installation", "authentication"],
            "additionalProperties": false,
            "properties": {
              "installation": { "type": "string", "enum": ["AVAILABLE", "REQUIRED", "DISABLED"] },
              "authentication": { "type": "string", "enum": ["ON_INSTALL", "ON_USE", "NONE"] }
            }
          }
        }
      }
    }
  }
}
